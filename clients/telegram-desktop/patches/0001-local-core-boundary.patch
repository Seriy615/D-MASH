+    Handle server(CreateNamedPipeW(name.c_str(), PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+        PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS, 1, 65536, 65536, 0, &attributes));
+    require(server.value != INVALID_HANDLE_VALUE);
+    attributes.bInheritHandle = TRUE;
+    Handle child(CreateFileW(name.c_str(), GENERIC_READ | GENERIC_WRITE | READ_CONTROL, 0, &attributes,
+                             OPEN_EXISTING, FILE_FLAG_OVERLAPPED, nullptr));
+    require(child.value != INVALID_HANDLE_VALUE);
+    OVERLAPPED connected{}; Handle event(CreateEventW(nullptr, TRUE, FALSE, nullptr)); require(event.value);
+    connected.hEvent = event.value;
+    const bool connectedNow = ConnectNamedPipe(server.value, &connected);
+    require(connectedNow || GetLastError() == ERROR_PIPE_CONNECTED);
+    requirePrivatePipe(reinterpret_cast<std::uintptr_t>(server.value));
+    requirePrivatePipe(reinterpret_cast<std::uintptr_t>(child.value));
+    require(SetHandleInformation(server.value, HANDLE_FLAG_INHERIT, 0));
+    std::wstring command = quoted(executable);
+    for (const auto& arg : arguments) {
+        for (const auto* reserved : {L"--bootstrap-handle", L"--bootstrap-fd", L"--bundle"})
+            require(arg != reserved && arg.rfind(std::wstring(reserved) + L"=", 0) != 0);
+        command += L" " + quoted(arg);
+    }
+    command += L" --bootstrap-handle " + std::to_wstring(reinterpret_cast<std::uintptr_t>(child.value));
+    require(command.size() < 32767);
+    SIZE_T bytes = 0; InitializeProcThreadAttributeList(nullptr, 1, 0, &bytes); require(bytes > 0);
+    std::vector<unsigned char> storage(bytes);
+    auto* list = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(storage.data());
+    require(InitializeProcThreadAttributeList(list, 1, 0, &bytes));
+    struct AttributeCleanup { LPPROC_THREAD_ATTRIBUTE_LIST value; ~AttributeCleanup() { DeleteProcThreadAttributeList(value); } } cleanup{list};
+    require(UpdateProcThreadAttribute(list, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, &child.value, sizeof(child.value), nullptr, nullptr));
+    STARTUPINFOEXW startup{}; startup.StartupInfo.cb = sizeof(startup); startup.lpAttributeList = list;
+    PROCESS_INFORMATION info{};
+    require(CreateProcessW(executable.c_str(), command.data(), nullptr, nullptr, TRUE,
+        EXTENDED_STARTUPINFO_PRESENT | CREATE_NO_WINDOW, nullptr, nullptr, &startup.StartupInfo, &info));
+    CloseHandle(info.hThread);
+    ChildProcess result;
+    result.process = reinterpret_cast<std::uintptr_t>(info.hProcess);
+    result.parentPipe = reinterpret_cast<std::uintptr_t>(server.value); server.value = nullptr;
+    result.pid = info.dwProcessId;
+    return result;
+}
+void requireSameUserPipe(std::uintptr_t raw) {
+    HANDLE pipe = reinterpret_cast<HANDLE>(raw);
+    require(GetFileType(pipe) == FILE_TYPE_PIPE);
+    DWORD flags = 0; ULONG pid = 0;
+    require(GetNamedPipeInfo(pipe, &flags, nullptr, nullptr, nullptr));
+    require((flags & PIPE_SERVER_END) ? GetNamedPipeClientProcessId(pipe, &pid)
+                                    : GetNamedPipeServerProcessId(pipe, &pid));
+    require(pid != 0);
+    Handle peer(OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid));
+    require(peer.value != nullptr);
+    auto theirs = tokenUser(peer.value), current = tokenUser(GetCurrentProcess());
+    require(EqualSid(sid(theirs), sid(current)));
+}
+void requirePrivatePipe(std::uintptr_t raw) {
+    auto current = tokenUser(GetCurrentProcess()); PACL acl = nullptr; Local descriptor;
+    require(GetSecurityInfo(reinterpret_cast<HANDLE>(raw), SE_KERNEL_OBJECT, DACL_SECURITY_INFORMATION,
+                            nullptr, nullptr, &acl, nullptr, reinterpret_cast<PSECURITY_DESCRIPTOR*>(&descriptor.value)) == ERROR_SUCCESS);
+    privateDacl(acl, sid(current));
+}
+void ensurePrivateProfile(const std::wstring& path) {
+    if (GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) {
+        require(GetLastError() == ERROR_FILE_NOT_FOUND || GetLastError() == ERROR_PATH_NOT_FOUND);
+        auto current = tokenUser(GetCurrentProcess()); Local stringSid, descriptor;
+        require(ConvertSidToStringSidW(sid(current), reinterpret_cast<LPWSTR*>(&stringSid.value)));
+        const std::wstring user = static_cast<wchar_t*>(stringSid.value);
+        const std::wstring sddl = L"O:" + user + L"D:P(A;OICI;FA;;;" + user + L")(A;OICI;FA;;;SY)";
+        require(ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl.c_str(), SDDL_REVISION_1,
+                    reinterpret_cast<PSECURITY_DESCRIPTOR*>(&descriptor.value), nullptr));
+        SECURITY_ATTRIBUTES attributes{sizeof(attributes), descriptor.value, FALSE};
+        require(CreateDirectoryW(path.c_str(), &attributes));
+    }
+    verifyFile(path, false, true);
+    for (const auto* file : {L"node.sqlite", L"node.sqlite-wal", L"node.sqlite-shm", L"owner.lock"})
+        requirePrivateFile(path + L"\\" + file, true);
+}
+void requirePrivateFile(const std::wstring& path, bool allowMissing) { verifyFile(path, allowMissing, false); }
+}
+#endif
diff --git a/dmash/os_windows.h b/dmash/os_windows.h
new file mode 100644
index 0000000..658f5fb
--- /dev/null
+++ b/dmash/os_windows.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// The upstream OpenSSL linking exception in ../LICENSE applies.
+// Original D-MASH MIT-origin IPC/platform helper retained in this GPL client fork.
+#pragma once
+#ifdef _WIN32
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace dmash::windowsLocal {
+// Owns only this spawned process handle and its broker lifetime lease. Closing
+// process does not kill the child; the daemon observes bootstrap lease EOF.
+struct ChildProcess final {
+    std::uintptr_t process = 0, parentPipe = 0;
+    std::uint32_t pid = 0;
+    ChildProcess() = default;
+    ~ChildProcess();
+    ChildProcess(const ChildProcess&) = delete;
+    ChildProcess& operator=(const ChildProcess&) = delete;
+    ChildProcess(ChildProcess&&) noexcept;
+    ChildProcess& operator=(ChildProcess&&) noexcept;
+    // Transfer to QLocalSocket::setSocketDescriptor; its owner retains the lease.
+    std::uintptr_t releaseParentPipe() noexcept;
+};
+// Arguments contain paths/options only, never credentials. Appends the private
+// bootstrap handle; only that child pipe endpoint is inherited by CreateProcess.
+ChildProcess spawnDaemon(const std::wstring& executable, const std::vector<std::wstring>& arguments);
+// Shared by broker, daemon and GUI. No credential material enters these helpers.
+void requireSameUserPipe(std::uintptr_t handle);
+void requirePrivatePipe(std::uintptr_t handle);
+void ensurePrivateProfile(const std::wstring& path);
+void requirePrivateFile(const std::wstring& path, bool allowMissing = false);
+}
+#endif
diff --git a/dmash/session_adapter.cpp b/dmash/session_adapter.cpp
new file mode 100644
index 0000000..11df51c
--- /dev/null
+++ b/dmash/session_adapter.cpp
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Upstream OpenSSL linking exception in ../LICENSE applies.
+#include "session_adapter.h"
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <QUuid>
+#include <limits>
+#include <utility>
+#include <stdexcept>
+
+SessionAdapter::SessionAdapter(QString profile,QObject* parent):QObject(parent),client_(std::move(profile),this){
+ connect(&client_,&LocalClient::response,this,&SessionAdapter::response);
+ connect(&client_,&LocalClient::sessionInvalidated,this,[this]{pendingControl_.clear();clear();});
+ connect(&client_,&LocalClient::busyChanged,this,&SessionAdapter::busyChanged);
+ connect(&client_,&LocalClient::hostStatusReady,this,[this](const QJsonObject& value){if(loggedIn_&&(value.value("rootLocked").toBool()||!value.value("accountSessionActive").toBool()))clear();});
+ sync_.setInterval(2000);connect(&sync_,&QTimer::timeout,this,[this]{if(loggedIn_&&!client_.busy())request("account.sync");});request("account.listAccounts");
+}
+void SessionAdapter::request(const QString& method,const QJsonObject& params){if(client_.busy())return;requestEpoch_=epoch_;client_.request(method,params);}
+void SessionAdapter::clear(){++epoch_;sync_.stop();loggedIn_=false;account_.clear();historyPeer_.clear();wantedPeer_.clear();activePeer_.clear();peers_.clear();nativePeers_.clear();messages_.clear();nextPeer_=1;nextMessage_=1;Q_EMIT cleared();}
+QString SessionAdapter::newOperationId(){return QUuid::createUuid().toString(QUuid::Id128)+QUuid::createUuid().toString(QUuid::Id128);}
+quint64 SessionAdapter::localPeerId(const QString& peer){if(peer.isEmpty()||peer.size()>2048)throw std::runtime_error("INVALID_CORE_PEER");if(peers_.contains(peer))return peers_.value(peer);if(!nextPeer_||nextPeer_>quint64(std::numeric_limits<qint64>::max()))throw std::runtime_error("LOCAL_PEER_LIMIT");const auto local=nextPeer_++;if(nativePeers_.contains(local))throw std::runtime_error("LOCAL_PEER_COLLISION");peers_.insert(peer,local);nativePeers_.insert(local,peer);return local;}
+QString SessionAdapter::nativePeer(quint64 id)const{return nativePeers_.value(id);}
+void SessionAdapter::unlock(const QString& pin){request("root.unlock",{{"pin",pin}});}
+void SessionAdapter::login(const QString& identity,const QString& password){request("account.login",{{"identity",identity},{"password",password}});}
+void SessionAdapter::logout(){clear();if(client_.busy()){pendingControl_="account.logout";client_.cancel();}else request("account.logout");}
+void SessionAdapter::lockRoot(){clear();if(client_.busy()){pendingControl_="root.lock";client_.cancel();}else request("root.lock");}
+void SessionAdapter::loadHistory(const QString& peer){if(!loggedIn_)return;activePeer_=peer;if(client_.busy()){wantedPeer_=peer;return;}historyPeer_=peer;request("account.history",{{"peer",peer},{"before",0},{"limit",50}});}
+void SessionAdapter::sendText(const QString& peer,const QString& operationId,const QString& text){if(!loggedIn_||client_.busy())return;if(!QRegularExpression("^[0-9a-f]{64}$").match(operationId).hasMatch()){Q_EMIT failed("INVALID_OPERATION_ID");return;}request("account.sendText",{{"peer",peer},{"operationId",operationId},{"text",text}});}
+void SessionAdapter::response(const QString& method,bool ok,const QString& code,const QJsonObject& result){
+ if(!pendingControl_.isEmpty()){const auto next=std::exchange(pendingControl_,{});request(next);return;}
+ if(requestEpoch_!=epoch_)return;
+ if(!ok){if(code=="ROOT_UNLOCK_REQUIRED"||code=="CREDENTIAL_HOST_DISCONNECTED"||code=="CREDENTIAL_HOST_UNAVAILABLE")clear();Q_EMIT failed(code);return;}
+ const auto value=result.value("value").toObject();const auto rows=result.value("rows").toArray();
+ try{
+  if(method=="root.unlock"||method=="account.listAccounts"){Q_EMIT accounts(rows);const auto active=value.value("activeAccount").toObject();if(!active.isEmpty())activate(active);}
+  else if(method=="account.login"){
+   activate(value);
+  }else if(method=="account.contacts"){
+   QJsonArray projected;for(const auto& item:rows){auto row=item.toObject();row["localPeerId"]=qint64(localPeerId(row.value("id").toString()));projected.append(row);}Q_EMIT contacts(projected);
+  }else if(method=="account.history"){
+   QJsonArray projected;const auto peer=std::exchange(historyPeer_,{});for(const auto& item:rows){auto row=item.toObject();const auto operation=row.value("operationId").toString();const auto sequence=row.value("sequence").toInteger();if(sequence<0||(sequence==0&&operation.isEmpty()))throw std::runtime_error("INVALID_CORE_HISTORY_ID");
+    const auto key=peer+"/"+(operation.isEmpty()?"sequence:"+QString::number(sequence):"operation:"+operation);
+    if(!messages_.contains(key)){if(nextMessage_>std::numeric_limits<qint32>::max())throw std::runtime_error("LOCAL_MESSAGE_LIMIT");messages_.insert(key,qint32(nextMessage_++));}
+    row["localMessageId"]=-messages_.value(key);const auto state=row.value("state").toString();row["pending"]=state=="HANDSHAKE_PENDING"||state=="APPLICATION_PENDING"||state=="NODE_ACCEPTED";row["recipientDelivered"]=state=="DELIVERED";projected.append(row);
+   }Q_EMIT history(peer,projected);if(!wantedPeer_.isEmpty()){const auto next=std::exchange(wantedPeer_,{});loadHistory(next);}
+  }else if(method=="account.sendText"){Q_EMIT accepted(value);if(value.value("accepted").toBool()&&!activePeer_.isEmpty())loadHistory(activePeer_);}
+  else if(method=="account.sync"&&!activePeer_.isEmpty())loadHistory(activePeer_);
+  else if(method=="account.logout"||method=="root.lock")clear();
+ }catch(const std::exception& error){clear();Q_EMIT failed(QString::fromLatin1(error.what()));}
+}
+
+void SessionAdapter::activate(const QJsonObject& value){clear();account_=value.value("accountPublicId").toString();if(!QRegularExpression("^[0-9a-f]{64}$").match(account_).hasMatch())throw std::runtime_error("INVALID_CORE_ACCOUNT");loggedIn_=true;const auto self=localPeerId("local:saved-messages:v1");peers_.insert(account_,self);Q_EMIT authenticated(value);request("account.contacts");sync_.start();}
+
+void SessionAdapter::refreshContacts(){if(loggedIn_&&!client_.busy())request("account.contacts");}
diff --git a/dmash/session_adapter.h b/dmash/session_adapter.h
new file mode 100644
index 0000000..796d1b2
--- /dev/null
+++ b/dmash/session_adapter.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Upstream OpenSSL linking exception in ../LICENSE applies.
+#pragma once
+#include "local_client.h"
+#include <QHash>
+#include <QJsonArray>
+#include <QTimer>
+
+// Memory-only bridge. Native encrypted Account storage remains authoritative.
+// Numeric identifiers below never enter a D-MASH network/credential request.
+class SessionAdapter final:public QObject {
+ Q_OBJECT
+public:
+ explicit SessionAdapter(QString nativeProfile,QObject* parent=nullptr);
+ void unlock(const QString& pin);void login(const QString& identity,const QString& password);
+ void refreshContacts();bool busy()const{return client_.busy();}
+ void logout();void lockRoot();void loadHistory(const QString& nativePeer);
+ void sendText(const QString& nativePeer,const QString& operationId,const QString& text);
+ quint64 localPeerId(const QString& nativePeer);QString nativePeer(quint64 localId)const;
+ static QString newOperationId();
+Q_SIGNALS:
+ void accounts(const QJsonArray& rows);void authenticated(const QJsonObject& account);void cleared();
+ void contacts(const QJsonArray& rows);void history(const QString& nativePeer,const QJsonArray& rows);
+ void accepted(const QJsonObject& value);void failed(const QString& code);void busyChanged(bool busy);
+private:
+ void activate(const QJsonObject&);
+ void request(const QString&,const QJsonObject& params={});
+ quint64 epoch_=0,requestEpoch_=0;QString pendingControl_;
+ void response(const QString&,bool,const QString&,const QJsonObject&);void clear();
+ LocalClient client_;QTimer sync_;QHash<QString,quint64> peers_;QHash<quint64,QString> nativePeers_;
+ QHash<QString,qint32> messages_;quint64 nextPeer_=1;qint64 nextMessage_=1;QString account_,historyPeer_,wantedPeer_,activePeer_;bool loggedIn_=false;
+};
