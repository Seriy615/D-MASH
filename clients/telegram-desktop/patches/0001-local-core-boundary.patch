+base::flat_map<Main::Account*,SessionAdapter*> Adapters;
+MTPUser PresentationUser(quint64 id,const QString& name,bool self){
+ return MTP_user(MTP_flags(MTPDuser::Flag::f_first_name|(self?MTPDuser::Flag::f_self:MTPDuser::Flag::f_contact)),MTP_long(id),MTPlong(),MTP_string(name),MTPstring(),MTPstring(),MTPstring(),MTPUserProfilePhoto(),MTPUserStatus(),MTPint(),MTPVector<MTPRestrictionReason>(),MTPstring(),MTPstring(),MTPEmojiStatus(),MTPVector<MTPUsername>(),MTPint(),MTPPeerColor(),MTPPeerColor(),MTPint(),MTPlong(),MTPlong());
+}
+void ProjectContacts(Main::Account* account,SessionAdapter* adapter,const QJsonArray& rows){
+ if(!account->sessionExists())return;auto& data=account->session().data();
+ for(const auto& entry:rows){const auto row=entry.toObject();const auto id=adapter->localPeerId(row.value("id").toString());const auto peer=data.processUser(PresentationUser(id,row.value("name").toString(),id==1));auto history=data.history(peer);history->clearFolder();history->updateChatListExistence();}
+ data.contactsLoaded()=true;data.chatsListDone(nullptr);
+}
+void ProjectHistory(Main::Account* account,SessionAdapter* adapter,const QString& native,const QJsonArray& rows){
+ if(!account->sessionExists())return;auto& data=account->session().data();const auto peer=peerFromUser(UserId(adapter->localPeerId(native)));auto history=data.history(peer);history->clearFolder();
+ for(const auto& entry:rows){const auto row=entry.toObject();const auto id=MsgId(row.value("localMessageId").toInt());auto item=data.message(FullMsgId(peer,id));const bool pending=row.value("pending").toBool();if(item){item->setText(TextWithEntities{.text=row.value("text").toString()});item->setDmashPending(pending);}else{
+  auto flags=MessageFlags(MessageFlag::HasFromId);const bool out=row.value("direction").toString()==u"out"_q;if(out)flags|=MessageFlag::Outgoing;if(pending)flags|=MessageFlag::BeingSent;
+  item=history->addNewLocalMessage({.id=id,.flags=flags,.from=out?peerFromUser(UserId(1)):peer,.date=TimeId(row.value("time").toInteger()/1000)},TextWithEntities{.text=row.value("text").toString()},MTP_messageMediaEmpty());
+ }history->setLastMessage(item);history->setChatListMessage(item);}
+ history->updateChatListExistence();
+}
+}
+SessionAdapter& Adapter(Main::Account* account){if(const auto i=Adapters.find(account);i!=Adapters.end())return *i->second;
+ auto profile=qEnvironmentVariable("DMASH_PROFILE");if(profile.isEmpty())profile=QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation)+u"/D-MASH/native-profile"_q;
+ const auto adapter=new SessionAdapter(profile);Adapters.emplace(account,adapter);account->lifetime().add([=]{Adapters.erase(account);delete adapter;});
+ QObject::connect(adapter,&SessionAdapter::authenticated,adapter,[=](const QJsonObject& value){if(!account->sessionExists())account->createSession(PresentationUser(1,value.value("displayName").toString(),true));});
+ QObject::connect(adapter,&SessionAdapter::cleared,adapter,[=]{account->dmashClearPresentation();});
+ QObject::connect(adapter,&SessionAdapter::contacts,adapter,[=](const QJsonArray& rows){ProjectContacts(account,adapter,rows);});
+ QObject::connect(adapter,&SessionAdapter::history,adapter,[=](const QString& peer,const QJsonArray& rows){ProjectHistory(account,adapter,peer,rows);});
+ return *adapter;
+}
+void RequestContacts(Main::Session* session){Adapter(&session->account()).refreshContacts();}
+QString NativePeer(Main::Session* session,PeerId peer){return Adapter(&session->account()).nativePeer(peerToUser(peer).bare);}
+void RequestHistory(Main::Session* session,PeerId peer){const auto native=NativePeer(session,peer);if(!native.isEmpty())Adapter(&session->account()).loadHistory(native);}
+}
