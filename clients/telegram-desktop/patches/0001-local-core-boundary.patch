@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// The OpenSSL linking exception in ../LICENSE applies to this fork source.
+// Actual upstream UI toolkit / Root IPC integration harness, not a chat mockup.
+#include "tests/test_main.h"
+#include "local_client.h"
+#include "ui/widgets/labels.h"
+#include "ui/widgets/buttons.h"
+#include "ui/widgets/fields/password_input.h"
+#include "ui/widgets/rp_window.h"
+#include "styles/style_widgets.h"
+#include <QStandardPaths>
+#include <QJsonArray>
+
+namespace Test {
+QString name(){return u"D-MASH-Root-Bridge"_q;}
+void test(not_null<Ui::RpWindow*> window,not_null<Ui::RpWidget*> body){
+ window->setWindowTitle(u"D-MASH · original Telegram UI integration"_q);
+ auto profile=qEnvironmentVariable("DMASH_PROFILE");
+ if(profile.isEmpty())profile=QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation)+u"/D-MASH/native-profile"_q;
+ const auto client=new LocalClient(profile,body);
+ const auto title=new Ui::FlatLabel(body,u"D-MASH"_q,st::defaultFlatLabel);
+ const auto detail=new Ui::FlatLabel(body,u"Create or unlock your local profile."_q,st::defaultSubTextLabel);
+ const auto pin=new Ui::PasswordInput(body,st::defaultInputField,rpl::single(u"Device PIN"_q));pin->setObjectName(u"rootPin"_q);
+ const auto create=new Ui::RoundButton(body,rpl::single(u"Create profile"_q),st::defaultActiveButton);create->setObjectName(u"createProfile"_q);
+ const auto unlock=new Ui::RoundButton(body,rpl::single(u"Unlock profile"_q),st::defaultLightButton);unlock->setObjectName(u"unlockProfile"_q);
+ const auto lock=new Ui::RoundButton(body,rpl::single(u"Lock device"_q),st::defaultLightButton);lock->setObjectName(u"lockDevice"_q);lock->setDisabled(true);
+ const auto status=new Ui::FlatLabel(body,u"Connecting to the resident D-MASH core…"_q,st::defaultSubTextLabel);status->setObjectName(u"profileStatus"_q);
+ body->sizeValue()|rpl::start_with_next([=](QSize size){const auto x=(size.width()-320)/2;title->move(x,70);detail->move(x,110);pin->setGeometry(x,160,320,52);create->setGeometry(x,236,320,44);unlock->setGeometry(x,292,320,44);lock->setGeometry(x,348,320,44);status->resizeToWidth(320);status->move(x,418);},body->lifetime());
+ QObject::connect(client,&LocalClient::busyChanged,body,[=](bool busy){create->setDisabled(busy);unlock->setDisabled(busy);pin->setDisabled(busy);});
+ QObject::connect(client,&LocalClient::hostStatusReady,body,[=](const QJsonObject& value){status->setText(value.value("rootLocked").toBool()?u"Profile is locked."_q:u"Profile is unlocked."_q);lock->setDisabled(value.value("rootLocked").toBool());});
+ QObject::connect(client,&LocalClient::response,body,[=](const QString& method,bool ok,const QString&,const QJsonObject& result){if(!ok){status->setText(u"Could not complete this action. The existing profile was kept."_q);return;}const auto value=result.value("value").toObject();if(method==u"profile.create"_q||method==u"root.unlock"_q){status->setText(u"Profile unlocked. Account data remains in the resident core."_q);lock->setDisabled(false);}else if(method==u"root.lock"_q){status->setText(u"Profile locked."_q);lock->setDisabled(true);}});
+ create->setClickedCallback([=]{if(pin->getLastText().isEmpty()){pin->showError();return;}const auto value=pin->getLastText();pin->setText(QString());client->request(u"profile.create"_q,{{u"pin"_q,value}});});
+ unlock->setClickedCallback([=]{if(pin->getLastText().isEmpty()){pin->showError();return;}const auto value=pin->getLastText();pin->setText(QString());client->request(u"root.unlock"_q,{{u"pin"_q,value}});});
+ lock->setClickedCallback([=]{client->request(u"root.lock"_q);});
+ client->request(u"host.status"_q);
+}
