+struct Peer:QObject{
+ QLocalServer server;QLocalSocket* socket=nullptr;QByteArray input;QString active=QString(64,'a');qint64 epoch=1;
+ QList<QJsonObject> requests;QJsonObject held;bool holdHistory=false;
+ Peer(const QString& path){check(server.listen(QDir(path).filePath("peer")),"listen");QFile locator(QDir(path).filePath("credential-endpoint.json"));check(locator.open(QIODevice::WriteOnly),"locator");locator.write(QJsonDocument(QJsonObject{{"v",1},{"endpoint",server.fullServerName()}}).toJson());locator.close();QObject::connect(&server,&QLocalServer::newConnection,this,[this]{socket=server.nextPendingConnection();input.clear();QObject::connect(socket,&QLocalSocket::readyRead,this,[this]{read();});});}
+ QJsonObject identity()const{return {{"accountPublicId",active},{"sessionEpoch",epoch},{"displayName","Synthetic"}};}
+ void reply(const QJsonObject& request,bool ok,QJsonObject result={},QString code={}){auto body=QJsonDocument(QJsonObject{{"v",1},{"id",request.value("id")},{"ok",ok},{"code",code},{"result",result}}).toJson(QJsonDocument::Compact);QByteArray frame(4,0);qToBigEndian<quint32>(body.size(),frame.data());frame+=body;socket->write(frame);socket->flush();}
+ int count(const QString& method)const{int n=0;for(const auto& r:requests)if(r.value("method")==method)++n;return n;}
+ void read(){input+=socket->readAll();while(input.size()>=4){const auto length=qFromBigEndian<quint32>(input.constData());if(input.size()<4+int(length))return;const auto r=QJsonDocument::fromJson(input.mid(4,length)).object();input.remove(0,4+length);requests.append(r);const auto method=r.value("method").toString();
+  if(method=="host.status")reply(r,true,{{"value",QJsonObject{{"rootLocked",false},{"accountSessionActive",true},{"account",identity()}}}});
+  else if(method=="account.listAccounts")reply(r,true,{{"value",QJsonObject{{"activeAccount",identity()}}},{"rows",QJsonArray{QJsonObject{{"identity","Synthetic"},{"accountPublicId",active}}}}});
+  else if(method=="account.login")reply(r,true,{{"value",identity()}});
+  else if(method=="account.attach"){if(r.value("params").toObject().value("accountPublicId")!=active)reply(r,false,{},"ACCOUNT_SESSION_CHANGED");else reply(r,true,{{"value",identity()}});}
+  else if(method=="account.history"&&holdHistory)held=r;
+  else reply(r,true,{{"rows",QJsonArray{}}});
+ }}
+};
+}
+int main(int argc,char**argv){QCoreApplication app(argc,argv);try{
+ QTemporaryDir profile;check(profile.isValid(),"profile");Peer peer(profile.path());SessionAdapter adapter(profile.path());int authenticated=0,cleared=0,histories=0;QString lastAccount,lastError;
+ QObject::connect(&adapter,&SessionAdapter::authenticated,&app,[&](const QJsonObject& a){++authenticated;lastAccount=a.value("accountPublicId").toString();});
+ QObject::connect(&adapter,&SessionAdapter::cleared,&app,[&]{++cleared;});QObject::connect(&adapter,&SessionAdapter::failed,&app,[&](const QString& e){lastError=e;});QObject::connect(&adapter,&SessionAdapter::history,&app,[&]{++histories;});
+ wait([&]{return peer.count("account.listAccounts")==1&&!adapter.busy();});check(authenticated==0,"inventory must not bind observed Account");check(peer.count("account.contacts")==0,"unbound inventory read");
+ adapter.login("Synthetic","Synthetic password");wait([&]{return authenticated==1&&!adapter.busy();});check(lastAccount==QString(64,'a'),"login identity");check(peer.count("account.contacts")==1,"bound contacts");
+ peer.holdHistory=true;adapter.loadHistory("local:saved-messages:v1");wait([&]{return !peer.held.isEmpty();});adapter.loadHistory("old-delayed-peer");adapter.logout();peer.reply(peer.held,true,{{"rows",QJsonArray{QJsonObject{{"text","old RAM row"},{"sequence",1}}}}});wait([&]{return peer.count("account.logout")==1&&!adapter.busy();});check(histories==0,"stale callback projected rows");check(peer.count("account.history")==1,"deferred old Account history dispatched");
+ peer.active=QString(64,'b');peer.epoch=2;adapter.attach(QString(64,'a'));wait([&]{return !adapter.busy();});check(authenticated==1&&lastError=="ACCOUNT_SESSION_CHANGED","wrong attachment followed observed Account");
+ peer.active=QString(64,'a');peer.epoch=3;adapter.attach(QString(64,'a'));wait([&]{return authenticated==2&&!adapter.busy();});check(lastAccount==QString(64,'a'),"exact explicit attachment");
+ const auto beforeClear=cleared;peer.socket->disconnectFromServer();wait([&]{return cleared>beforeClear;});check(lastError=="CREDENTIAL_HOST_DISCONNECTED","idle disconnect did not invalidate");
+ peer.active=QString(64,'b');peer.epoch=4;adapter.refreshContacts();QCoreApplication::processEvents();check(authenticated==2,"idle reconnect followed other Account");
+ std::cout<<"PASS inventory cannot bind; login/explicit exact attach; wrong attach; deferred old history/callback fenced; idle disconnect clears RAM\n";return 0;
+ }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
