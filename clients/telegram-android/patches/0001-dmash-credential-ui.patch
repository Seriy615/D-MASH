+/* D-MASH adaptation of the Telegram client. GPL-2.0-or-later; see LICENSE. */
+package org.telegram.messenger.dmash;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.widget.Toast;
+import org.dmash.client.CredentialConnection;
+import org.dmash.client.CredentialService;
+import org.json.*;
+import org.telegram.messenger.*;
+import org.telegram.tgnet.TLRPC;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.*;
+
+/** IPC-only UI projection. Root, Account keys, durable history and outbox remain in the credential process. */
+public final class DmashClient {
+    public static final boolean ENABLED = true;
+    public static final String SAVED = "local:saved-messages:v1";
+    public interface Observer { void changed(JSONObject status, String error); }
+    public interface Reply { void done(boolean ok, String code, JSONObject result); }
+    private static final ArrayList<Observer> observers = new ArrayList<>();
+    private static final ArrayDeque<Runnable> requests = new ArrayDeque<>();
+    private static final HashMap<Long,String> peers = new HashMap<>();
+    private static final HashMap<Integer,String> pendingIds = new HashMap<>();
+    private static CredentialConnection connection;
+    private static JSONObject status = new JSONObject();
+    private static boolean ready, busy, accountActive;
+    private static String self;
+    private static final HashMap<Long,int[]> histories=new HashMap<>();
+    private static final android.os.Handler main=new android.os.Handler(android.os.Looper.getMainLooper());
+    private static boolean foreground;
+    private static final Runnable poll=new Runnable(){public void run(){if(!foreground)return;if(ready&&!busy&&requests.isEmpty()){refresh();if(accountActive)request("account.sync",object(),(ok,code,result)->{if(ok){loadDialogs(MessagesController.getInstance(0));for(Map.Entry<Long,int[]> entry:new HashMap<>(histories).entrySet()){int[] h=entry.getValue();loadHistory(MessagesController.getInstance(0),entry.getKey(),h[0],0,h[1],2,h[2],h[3]);}}});}main.postDelayed(this,2000);}};
+    public static void foreground(boolean value){foreground=value;main.removeCallbacks(poll);if(value&&connection!=null)main.post(poll);}
+    private DmashClient() {}
+    public static boolean active() { return accountActive; }
+    public static JSONObject status() { return status; }
+    public static void observe(Observer observer) { observers.add(observer); observer.changed(status, ""); }
+    public static void unobserve(Observer observer) { observers.remove(observer); }
+    private static void publish(String error) { for (Observer o : new ArrayList<>(observers)) o.changed(status,error); }
+    public static JSONObject object(Object... pairs) {
+        JSONObject o=new JSONObject(); try { for(int i=0;i<pairs.length;i+=2)o.put((String)pairs[i],pairs[i+1]); } catch(JSONException e) { throw new IllegalArgumentException(e); } return o;
+    }
+    public static void connect(Context context) {
+        if(connection!=null)return;
+        Intent service=new Intent(context, CredentialService.class);
+        if(Build.VERSION.SDK_INT>=26)context.startForegroundService(service);else context.startService(service);
+        connection=new CredentialConnection(context,new CredentialConnection.Listener(){
+            public void ready(JSONObject initial) { ready=true; applyStatus(initial); drain(); }
+            public void busy(boolean value) { busy=value; }
+            public void disconnected(String code) { ready=false;accountActive=false;requests.clear();connection=null;clearProjection();publish(code); }
+        });
+    }
+    private static void drain() { if(ready&&!busy&&!requests.isEmpty()) requests.removeFirst().run(); }
+    public static void request(String method, JSONObject params, Reply callback) {
+        requests.add(()->connection.request(method,params,(ok,code,result)->{
+            if(ok&&method.equals("account.login")) { bind(result.optJSONObject("value")); }
+            if(ok&&(method.equals("account.logout")||method.equals("root.lock"))) { accountActive=false;clearProjection(); }
+            callback.done(ok,code,result); drain();
+        })); drain();
+    }
+    public static void cancel() { if(connection!=null)connection.cancel(); }
+    public static void refresh() { request("host.status",object(),(ok,code,result)->{if(ok)applyStatus(result.optJSONObject("value"));else publish(code);}); }
+    private static void applyStatus(JSONObject value) {
+        status=value==null?new JSONObject():value;
+        if(status.optBoolean("accountSessionActive"))bind(status.optJSONObject("account"));else if(accountActive){accountActive=false;clearProjection();}
+        publish("");
+    }
+    private static long peerId(String id) {
+        if(id.equals(SAVED)&&self!=null)id=self;
+        try {
+            long value=ByteBuffer.wrap(MessageDigest.getInstance("SHA-256").digest(id.getBytes(StandardCharsets.UTF_8))).getLong()&Long.MAX_VALUE;
+            if(value==0)value=1;
+            String old=peers.get(value);if(old!=null&&!old.equals(id))throw new IllegalStateException("DMASH_PUBLIC_ID_COLLISION");
+            peers.put(value,id);return value;
+        }catch(java.security.NoSuchAlgorithmException e){throw new IllegalStateException(e);}
+    }
+    private static TLRPC.TL_user user(String id,String name,boolean own) {
+        TLRPC.TL_user u=new TLRPC.TL_user();u.id=peerId(id);u.first_name=name;u.last_name="";u.phone="";u.self=own;u.contact=!own;u.flags|=2;u.status=new TLRPC.TL_userStatusOffline();return u;
+    }
+    private static void bind(JSONObject account) {
+        if(account==null||account.optString("accountPublicId").isEmpty())return;
+        self=account.optString("accountPublicId");accountActive=true;
+        TLRPC.User u=user(self,account.optString("displayName"),true);
+        UserConfig.getInstance(0).setCurrentUser(u);MessagesController.getInstance(0).putUser(u,false);
+    }
+    public static void clearProjection() {
+        self=null;peers.clear();pendingIds.clear();histories.clear();
+        MessagesController.getInstance(0).cleanup();MessagesStorage.getInstance(0).cleanup(false);
+        NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.closeChats);
+        NotificationCenter.getInstance(0).postNotificationName(NotificationCenter.appDidLogout);
+    }
+    private static String peer(long id) { String p=peers.get(id);if(p==null)throw new IllegalStateException("DMASH_UNKNOWN_PEER");return p.equals(self)?SAVED:p; }
+    public static void loadDialogs(MessagesController controller) {
+        if(!accountActive)return;
+        request("account.contacts",object(),(ok,code,result)->{
+            if(!ok){publish(code);return;}
+            TLRPC.TL_messages_dialogs dialogs=new TLRPC.TL_messages_dialogs();
+            JSONArray rows=result.optJSONArray("rows");
+            if(rows==null)return;
+            for(int i=0;i<rows.length();i++){
+                JSONObject row=rows.optJSONObject(i);if(row==null)continue;String id=row.optString("id");
+                boolean saved=id.equals(SAVED);TLRPC.User u=user(saved?self:id,row.optString("name"),saved);dialogs.users.add(u);
+                TLRPC.TL_dialog d=new TLRPC.TL_dialog();d.id=u.id;d.peer=new TLRPC.TL_peerUser();d.peer.user_id=u.id;d.notify_settings=new TLRPC.TL_peerNotifySettings();dialogs.dialogs.add(d);
+            }
+            controller.processLoadedDialogs(dialogs,null,null,0,0,dialogs.dialogs.size(),0,false,false,false);
+        });
+    }
+    private static TLRPC.Message message(long dialog,JSONObject row) {
+        TLRPC.TL_message m=new TLRPC.TL_message();int sequence=row.optInt("sequence");String operation=row.optString("operationId");
+        if(sequence>0)m.id=sequence;else{
+            int id=operation.hashCode()|Integer.MIN_VALUE;if(id==Integer.MIN_VALUE)id++;
+            String old=pendingIds.put(id,operation);if(old!=null&&!old.equals(operation))throw new IllegalStateException("DMASH_OPERATION_ID_COLLISION");m.id=id;
+        }
+        m.params=new HashMap<>();m.params.put("dmashOperationId",operation);
+        m.message=row.optString("text");m.date=(int)(row.optLong("time")/1000);m.out=!row.optString("direction").equals("in");m.dialog_id=dialog;
+        m.peer_id=new TLRPC.TL_peerUser();m.peer_id.user_id=dialog;m.from_id=new TLRPC.TL_peerUser();m.from_id.user_id=m.out?UserConfig.getInstance(0).getClientUserId():dialog;
+        m.unread=m.out; m.flags|=256; m.media=new TLRPC.TL_messageMediaEmpty();
+        m.send_state=sequence>0?MessageObject.MESSAGE_SEND_STATE_SENT:MessageObject.MESSAGE_SEND_STATE_SENDING;return m;
+    }
+    public static void loadHistory(MessagesController controller,long dialog,int count,int before,int guid,int loadType,int loadIndex,int mode) {
+        if(!accountActive)return;
+        histories.put(dialog,new int[]{count,guid,loadIndex,mode});
+        request("account.history",object("peer",peer(dialog),"before",Math.max(0,before),"limit",Math.min(100,Math.max(1,count))),(ok,code,result)->{
+            if(!ok){publish(code);return;}TLRPC.TL_messages_messages data=new TLRPC.TL_messages_messages();JSONArray rows=result.optJSONArray("rows");if(rows==null)return;
+            for(int i=0;i<rows.length();i++)data.messages.add(message(dialog,rows.optJSONObject(i)));
+            controller.processLoadedMessages(data,data.messages.size(),dialog,0,count,before,0,false,guid,0,0,0,0,loadType,true,mode,0,loadIndex,false,0,true,false,null);
+        });
+    }
+    public static void sendText(long dialog,String text,String retainedOperation) {
+        byte[] nonce=new byte[32];new java.security.SecureRandom().nextBytes(nonce);StringBuilder hex=new StringBuilder();for(byte b:nonce)hex.append(String.format(java.util.Locale.ROOT,"%02x",b&255));String operation=retainedOperation==null?hex.toString():retainedOperation;
+        request("account.sendText",object("peer",peer(dialog),"operationId",operation,"text",text),(ok,code,result)->{
+            if(!ok||result.optJSONObject("value")==null||!result.optJSONObject("value").optBoolean("accepted"))publish(ok?"MESSAGE_NOT_ACCEPTED":code);
+            loadDialogs(MessagesController.getInstance(0));
+            int[] h=histories.get(dialog);if(h!=null)loadHistory(MessagesController.getInstance(0),dialog,h[0],0,h[1],2,h[2],h[3]);
+        });
+    }
+}
