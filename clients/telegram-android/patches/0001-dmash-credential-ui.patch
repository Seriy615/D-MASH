+/* D-MASH authentication in the original Telegram navigation. GPL-2.0-or-later. */
+package org.telegram.ui.dmash;
+
+import android.content.Context;
+import android.content.Intent;
+import android.app.Activity;
+import android.os.Bundle;
+import android.text.InputType;
+import android.view.View;
+import android.view.Gravity;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import org.json.*;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.dmash.DmashClient;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.EditTextBoldCursor;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Cells.TextSettingsCell;
+import org.telegram.ui.LaunchActivity;
+
+/** Authentication uses the credential service, never Telegram phone/SMS auth. */
+public final class DmashLoginActivity extends BaseFragment implements DmashClient.Observer {
+    private EditTextBoldCursor pin,identity,password,name;
+    private TextView notice;
+    private LinearLayout content;
+    private boolean navigating;
+    private TextSettingsCell unlock,login,createRoot,createAccount,importProfile;
+    @Override public View createView(Context context) {
+        actionBar.setTitle("D-MASH");
+        ScrollView scroll=new ScrollView(context);fragmentView=scroll;
+        scroll.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+        content=new LinearLayout(context);content.setOrientation(LinearLayout.VERTICAL);content.setPadding(AndroidUtilities.dp(24),AndroidUtilities.dp(24),AndroidUtilities.dp(24),AndroidUtilities.dp(24));scroll.addView(content);
+        notice=new TextView(context);notice.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));notice.setText("Connecting to the messages service…");content.addView(notice,LayoutHelper.createLinear(-1,-2,0,0,0,16));
+        pin=field(context,"Device PIN",true);identity=field(context,"Account identity",false);password=field(context,"Account password",true);name=field(context,"Display name",false);
+        unlock=button(context,"Unlock device",()->call("root.unlock",DmashClient.object("pin",take(pin)),true));
+        login=button(context,"Sign in",()->call("account.login",DmashClient.object("identity",identity.getText().toString().trim(),"password",take(password)),false));
+        createRoot=button(context,"Create device Root",()->confirmPin(context));
+        createAccount=button(context,"Create Account",()->call("account.create",DmashClient.object("identity",identity.getText().toString().trim(),"password",take(password),"displayName",name.getText().toString().trim()),false));
+        importProfile=button(context,"Import complete profile",()->{Intent intent=new Intent(Intent.ACTION_OPEN_DOCUMENT).setType("application/json").addCategory(Intent.CATEGORY_OPENABLE);startActivityForResult(intent,501);});
+        button(context,"Cancel",DmashClient::cancel);
+        DmashClient.observe(this);DmashClient.connect(context);return fragmentView;
+    }
+    private EditTextBoldCursor field(Context context,String hint,boolean secret) {
+        EditTextBoldCursor edit=new EditTextBoldCursor(context);edit.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));edit.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText));edit.setHint(hint);edit.setTextSize(18);edit.setSingleLine(true);edit.setInputType(InputType.TYPE_CLASS_TEXT|(secret?InputType.TYPE_TEXT_VARIATION_PASSWORD:InputType.TYPE_TEXT_FLAG_CAP_SENTENCES));content.addView(edit,LayoutHelper.createLinear(-1,56));return edit;
+    }
+    private TextSettingsCell button(Context context,String text,Runnable action) {
+        TextSettingsCell cell=new TextSettingsCell(context);cell.setText(text,true);cell.setOnClickListener(v->action.run());content.addView(cell,LayoutHelper.createLinear(-1,56));return cell;
+    }
+    private static String take(EditTextBoldCursor field){String value=field.getText().toString();field.setText("");return value;}
+    private void confirmPin(Context context){
+        String first=take(pin);EditTextBoldCursor confirmation=new EditTextBoldCursor(context);confirmation.setSingleLine(true);confirmation.setHint("Confirm device PIN");confirmation.setInputType(InputType.TYPE_CLASS_TEXT|InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        new org.telegram.ui.ActionBar.AlertDialog.Builder(context).setTitle("Create device Root").setView(confirmation).setPositiveButton("Create",(dialog,which)->{String second=take(confirmation);if(!first.equals(second)||first.isEmpty()){notice.setText("PINs must match.");return;}call("profile.create",DmashClient.object("pin",first),true);}).setNegativeButton("Cancel",null).show();
+    }
+    private void call(String method,JSONObject params,boolean refresh){
+        setBusy(true);DmashClient.request(method,params,(ok,code,result)->{
+            setBusy(false);if(!ok){notice.setText(code);return;}
+            notice.setText("Ready");if(DmashClient.active())openDialogs();else DmashClient.refresh();
+        });
+    }
+    private void setBusy(boolean value){for(TextSettingsCell cell:new TextSettingsCell[]{unlock,login,createRoot,createAccount,importProfile})cell.setEnabled(!value);}
+    public void changed(JSONObject status,String error){
+        if(notice==null)return;if(!error.isEmpty()){notice.setText(error);return;}
+        boolean exists=status.optBoolean("profileExists"),locked=status.optBoolean("rootLocked",true);
+        createRoot.setVisibility(exists?View.GONE:View.VISIBLE);unlock.setVisibility(exists&&locked?View.VISIBLE:View.GONE);login.setVisibility(exists&&!locked?View.VISIBLE:View.GONE);createAccount.setVisibility(exists&&!locked?View.VISIBLE:View.GONE);
+        if(DmashClient.active())openDialogs();else notice.setText(!exists?"Create a device Root or import your complete profile.":locked?"Unlock your device Root.":"Sign in to your Account. Node can run independently.");
+    }
+    private void openDialogs(){if(navigating||getParentActivity()==null)return;navigating=true;Activity parent=getParentActivity();parent.recreate();}
+    @Override public void onActivityResultFragment(int request,int result,Intent data){
+        if(request!=501||result!=Activity.RESULT_OK||data==null||data.getData()==null)return;
+        try(java.io.InputStream input=getParentActivity().getContentResolver().openInputStream(data.getData());java.io.ByteArrayOutputStream bytes=new java.io.ByteArrayOutputStream()){
+            byte[] buffer=new byte[8192];int count;while((count=input.read(buffer))!=-1){if(bytes.size()+count>128*1024*1024)throw new java.io.IOException("PROFILE_IMPORT_SIZE");bytes.write(buffer,0,count);}
+            JSONObject profile=new JSONObject(bytes.toString("UTF-8"));call("profile.import",DmashClient.object("profile",profile,"pin",take(pin)),true);
+        }catch(Exception e){notice.setText("PROFILE_IMPORT_FAILED");}
+    }
+    @Override public void onFragmentDestroy(){DmashClient.unobserve(this);super.onFragmentDestroy();}
+}
