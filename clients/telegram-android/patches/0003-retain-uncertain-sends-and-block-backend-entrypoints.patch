+    public static void sendText(long dialog,String text,String retainedOperation,Reply reply) {
+        if(!accountActive) { reply.done(false,"ACCOUNT_LOGIN_REQUIRED",object());return; }
+        String target=peer(dialog);
+        UiIntent intent=retainedOperation==null?null:intents.get(retainedOperation);
+        // Repressing Send after an unknown reply reuses the original logical intent.
+        if(intent==null&&retainedOperation==null)for(UiIntent candidate:intents.values()) {
+            if(candidate.composerUncertain&&candidate.peer.equals(target)&&candidate.text.equals(text)) { intent=candidate;break; }
+        }
+        if(intent!=null&&(!intent.peer.equals(target)||!intent.text.equals(text))) {
+            reply.done(false,"OPERATION_ID_CONFLICT",object());return;
+        }
+        if(intent==null) {
+            intent=new UiIntent();intent.peer=target;intent.text=text;intent.time=System.currentTimeMillis();
+            if(retainedOperation==null) {
+                byte[] nonce=new byte[32];new java.security.SecureRandom().nextBytes(nonce);
+                StringBuilder hex=new StringBuilder();for(byte b:nonce)hex.append(String.format(Locale.ROOT,"%02x",b&255));
+                intent.operation=hex.toString();
+            } else intent.operation=retainedOperation;
+            intents.put(intent.operation,intent);
+        }
+        if(intent.accepted) {
+            intents.remove(intent.operation);reply.done(true,"",object("value",object("accepted",true,"operationId",intent.operation)));return;
+        }
+        intent.composerUncertain=true;intent.callbacks.add(reply);
+        if(intent.inFlight)return;
+        intent.inFlight=true;intent.state="UI_PENDING";
+        projectWatchedHistory(dialog);
+        final UiIntent sent=intent;final long epoch=accountEpoch;
+        request("account.sendText",object("peer",sent.peer,"operationId",sent.operation,"text",sent.text),(ok,code,result)->{
+            if(epoch!=accountEpoch||!accountActive)return;
+            sent.inFlight=false;
+            JSONObject value=result.optJSONObject("value");
+            boolean accepted=ok&&value!=null&&value.optBoolean("accepted");
+            sent.accepted=accepted;
+            sent.composerUncertain=!accepted;
+            boolean unknown=code.startsWith("CREDENTIAL_HOST_");
+            sent.state=accepted?value.optString("transportState","APPLICATION_PENDING"):unknown?"UI_UNCERTAIN":"FAILED";
+            if(!accepted)publish(ok?"MESSAGE_NOT_ACCEPTED":code);
+            ArrayList<Reply> callbacks=new ArrayList<>(sent.callbacks);sent.callbacks.clear();
+            for(Reply callback:callbacks)callback.done(accepted,code,result);
+            if(ready) {
+                loadDialogs(MessagesController.getInstance(0));
+                int[] h=histories.get(dialog);if(h!=null)loadHistory(MessagesController.getInstance(0),dialog,h[0],0,h[1],2,h[2],h[3]);
+            } else projectWatchedHistory(dialog);
         });
     }
